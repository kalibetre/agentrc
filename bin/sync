#!/usr/bin/env python3
"""Link ~/agentrc into every harness. Safe to re-run; only touches what it manages.

  bin/sync            apply everything
  bin/sync --dry-run  show what would change (skills and instructions only)
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from agentrc import *  # noqa: E402,F403

DRY = "--dry-run" in sys.argv


def sync_skills(log: Log) -> None:
    log.section("Skills")
    found = skills()
    for name, path in found.items():
        validate_skill(name, path, log)
    if log.errors:
        print("\nFix the skill errors above; nothing was linked.")
        sys.exit(1)

    targets = [AGENTS_SKILLS] + [h / "skills" for h in CLAUDE_HOMES]
    for target in targets:
        target.mkdir(parents=True, exist_ok=True)
        for entry in sorted(target.iterdir()):
            if entry.name in BUILTIN_SKILL_ENTRIES:
                continue
            ours = entry.is_symlink() and Path(os.readlink(entry)).parent == SKILLS
            if ours and entry.name in found:
                continue
            if DRY:
                log.change(f"would remove/quarantine {short(entry)}")
            elif entry.is_symlink():
                entry.unlink()
                log.change(f"removed stale link {short(entry)}")
            else:
                quarantine(entry, log, "not managed by agentrc")
        for name, path in found.items():
            link = target / name
            if not (link.is_symlink() and Path(os.readlink(link)) == path):
                if DRY:
                    log.change(f"would link {short(link)}")
                else:
                    ensure_symlink(link, path, log)
        log.ok(f"{short(target)}: {len(found)} skills")

    for d in FORBIDDEN_SKILL_DIRS:
        if d.exists() and not DRY:
            for entry in sorted(d.iterdir()):
                quarantine(entry, log, "harness-specific skills folder; use ~/agentrc/skills")
            d.rmdir()
            log.change(f"removed {short(d)}")


def sync_instructions(log: Log) -> None:
    log.section("Global instructions")
    for home in CLAUDE_HOMES:
        f = home / "CLAUDE.md"
        if f.is_file() and not f.is_symlink() and f.read_text() == CLAUDE_IMPORT:
            log.ok(f"{short(f)} imports AGENTS.md")
            continue
        if DRY:
            log.change(f"would write {short(f)}")
            continue
        if f.is_file() and f.read_text() == LEGACY_CLAUDE_IMPORT:
            pass  # written by this tool under its old name; nothing to keep
        elif f.exists() or f.is_symlink():
            backup = f.with_name("CLAUDE.md.pre-agentrc")
            os.replace(f, backup)
            log.change(f"kept old {short(f)} as {short(backup)}")
        f.write_text(CLAUDE_IMPORT)
        log.change(f"wrote {short(f)} (@~/agentrc/AGENTS.md)")

    links = [h / "AGENTS.md" for h in CODEX_HOMES + OPENCODE_HOMES + PI_HOMES]
    for link in links:
        if link.is_symlink() and Path(os.readlink(link)) == AGENTS_MD:
            log.ok(f"{short(link)} -> AGENTS.md")
        elif DRY:
            log.change(f"would link {short(link)}")
        else:
            ensure_symlink(link, AGENTS_MD, log)


def sync_policy(log: Log, state: dict) -> None:
    log.section("Approval policy (policy/ask.txt)")
    ask = claude_ask_rules()
    for home in CLAUDE_HOMES:
        f = home / "settings.json"
        data = load_json(f)
        perms = data.setdefault("permissions", {})
        previous = set(state.get("claude_ask", []))
        current = [r for r in perms.get("ask", []) if r not in previous]
        merged = current + [r for r in ask if r not in current]
        if merged != perms.get("ask"):
            perms["ask"] = merged
            save_json(f, data)
            log.change(f"{short(f)}: permissions.ask now has {len(ask)} agentrc rules")
        else:
            log.ok(f"{short(f)}: {len(ask)} ask rules")
    state["claude_ask"] = ask

    text = codex_rules_text()
    for home in CODEX_HOMES:
        legacy = home / "rules" / LEGACY_CODEX_RULES
        if legacy.exists():
            legacy.unlink()
            log.change(f"removed {short(legacy)} (old name)")
        f = home / "rules" / "agentrc.rules"
        if f.exists() and f.read_text() == text:
            log.ok(f"{short(f)}")
            continue
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(text)
        log.change(f"wrote {short(f)}")

    for home in OPENCODE_HOMES:
        f = home / "opencode.json"
        data = load_json(f)
        before = json.dumps(data, sort_keys=True)
        data.pop("permissions", None)  # V2 array; the installed OpenCode (V1) refuses to start with it
        perm = data.setdefault("permission", {})
        if isinstance(perm.get("bash"), str):
            perm["bash"] = {"*": perm["bash"]}
        bash = perm.setdefault("bash", {})
        for pattern in state.get("opencode_bash", []):
            bash.pop(pattern, None)
        new = opencode_rules()
        bash.update(new)
        if json.dumps(data, sort_keys=True) != before:
            save_json(f, data)
            log.change(f"{short(f)}: permission.bash has {len(new)} agentrc patterns")
        else:
            log.ok(f"{short(f)}: {len(new)} permission.bash patterns")
        state["opencode_bash"] = list(new)
        state.pop("opencode_rules", None)

    for home in PI_HOMES:
        legacy = home / "extensions" / LEGACY_PI_GUARD
        if legacy.is_symlink():
            legacy.unlink()
            log.change(f"removed {short(legacy)} (old name)")
        ensure_symlink(home / "extensions" / PI_GUARD.name, PI_GUARD, log)
        log.ok(f"{short(home / 'extensions' / PI_GUARD.name)}")


def claude_mcp_current(home: Path) -> dict:
    return load_json(home / ".claude.json").get("mcpServers", {})


def sync_mcp(log: Log, state: dict) -> None:
    log.section("MCP servers (mcp.json)")
    servers, skipped = mcp_servers(log)
    previous = set(state.get("mcp", []))
    removed = sorted(previous - set(servers) - set(skipped))

    # Claude Code: through its CLI, so running sessions don't race a direct file write.
    for home in CLAUDE_HOMES:
        env = dict(os.environ, CLAUDE_CONFIG_DIR=str(home))
        current = claude_mcp_current(home)
        for name in removed:
            if name in current:
                subprocess.run([PROGRAMS["claude"], "mcp", "remove", "-s", "user", name], env=env, capture_output=True)
                log.change(f"claude {short(home)}: removed {name}")
        for name, spec in servers.items():
            want = {"type": "http", "url": spec["url"], **({"headers": spec["headers"]} if spec["headers"] else {})}
            have = current.get(name)
            if have and {k: have.get(k) for k in want} == want:
                continue
            if have:
                subprocess.run([PROGRAMS["claude"], "mcp", "remove", "-s", "user", name], env=env, capture_output=True)
            cmd = [PROGRAMS["claude"], "mcp", "add", "-s", "user", "--transport", "http", name, spec["url"]]
            for k, v in spec["headers"].items():
                cmd += ["-H", f"{k}: {v}"]
            r = subprocess.run(cmd, env=env, capture_output=True, text=True)
            if r.returncode == 0:
                log.change(f"claude {short(home)}: {name}")
            else:
                log.error(f"claude {short(home)}: adding {name} failed: {r.stderr.strip()[:200]}")
        log.ok(f"claude {short(home)}: {', '.join(servers)}")

    # Codex: one marked block in config.toml.
    for home in CODEX_HOMES:
        f = home / "config.toml"
        text = f.read_text() if f.exists() else ""
        body = strip_toml_tables(strip_marked_block(text), list(servers) + removed).rstrip("\n")
        block = [MARK_BEGIN, "# MCP servers from ~/agentrc/mcp.json. Edit there, then run bin/sync."]
        for name, spec in servers.items():
            block += ["", f"[mcp_servers.{name}]", f"url = {toml_str(spec['url'])}"]
            if spec["headers"]:
                pairs = ", ".join(f"{toml_str(k)} = {toml_str(v)}" for k, v in spec["headers"].items())
                block.append(f"http_headers = {{ {pairs} }}")
        block.append(MARK_END)
        new = body + "\n\n" + "\n".join(block) + "\n"
        if new != text:
            f.write_text(new)
            log.change(f"{short(f)}: mcp_servers {', '.join(servers)}")
        else:
            log.ok(f"{short(f)}: {', '.join(servers)}")

    # OpenCode
    for home in OPENCODE_HOMES:
        f = home / "opencode.json"
        data = load_json(f)
        mcp = data.setdefault("mcp", {})
        before = json.dumps(mcp, sort_keys=True)
        for name in removed:
            mcp.pop(name, None)
        for name, spec in servers.items():
            entry = {"type": "remote", "url": spec["url"], "enabled": True}
            if spec["headers"]:
                entry["headers"] = spec["headers"]
            mcp[name] = entry
        if json.dumps(mcp, sort_keys=True) != before:
            save_json(f, data)
            log.change(f"{short(f)}: mcp {', '.join(servers)}")
        else:
            log.ok(f"{short(f)}: {', '.join(servers)}")

    # Pi
    for home in PI_HOMES:
        f = home / "mcp.json"
        data = load_json(f)
        mcp = data.setdefault("mcpServers", {})
        before = json.dumps(mcp, sort_keys=True)
        for name in removed:
            mcp.pop(name, None)
        for name, spec in servers.items():
            mcp[name] = {"url": spec["url"], **({"headers": spec["headers"]} if spec["headers"] else {})}
        if json.dumps(mcp, sort_keys=True) != before:
            save_json(f, data)
            os.chmod(f, 0o600)
            log.change(f"{short(f)}: mcpServers {', '.join(servers)}")
        else:
            log.ok(f"{short(f)}: {', '.join(servers)}")

    state["mcp"] = sorted(set(servers) | (previous & set(skipped)))


def sync_env(log: Log) -> None:
    log.section("Environment")
    block = (f"{MARK_BEGIN}\n# Managed by ~/agentrc/bin/sync.\n"
             "# OpenCode also scans ~/.claude/skills; the same skills already come from ~/.agents/skills.\n"
             f"export OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1\n{MARK_END}\n")
    text = ZSHENV.read_text() if ZSHENV.exists() else ""
    if not OPENCODE_HOMES:
        if MARK_BEGIN in text:
            rest = strip_marked_block(text).rstrip("\n")
            ZSHENV.write_text(rest + "\n" if rest else "")
            log.change(f"{short(ZSHENV)}: removed OPENCODE_DISABLE_CLAUDE_CODE_SKILLS (OpenCode not installed)")
        return
    if block in text:
        log.ok(f"{short(ZSHENV)}: OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1")
        return
    new = strip_marked_block(text).rstrip("\n")
    ZSHENV.write_text((new + "\n\n" if new else "") + block)
    log.change(f"{short(ZSHENV)}: OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1 (open a new shell)")


def main() -> None:
    log = Log()
    print(f"agentrc sync{' (dry run)' if DRY else ''}: {short(REPO)}")
    report_harnesses(log)
    if log.errors:
        print(f"\nFix {short(PROFILES_FILE)} first; nothing was changed.")
        sys.exit(1)
    sync_skills(log)
    sync_instructions(log)
    if not DRY:
        state = load_state()
        sync_policy(log, state)
        sync_mcp(log, state)
        sync_env(log)
        save_state(state)
    print(f"\n{len(log.errors)} error(s), {len(log.warnings)} warning(s). Run bin/doctor to verify.")
    sys.exit(1 if log.errors else 0)


if __name__ == "__main__":
    main()
