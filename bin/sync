#!/usr/bin/env node
// Link ~/agentrc into every harness. Safe to re-run; only touches what it manages.
//
//   bin/sync            apply everything
//   bin/sync --dry-run  show what would change (skills and instructions only)
import { spawnSync } from "node:child_process";
import { chmodSync, existsSync, mkdirSync, renameSync, rmdirSync, unlinkSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import {
  AGENTS_MD, AGENTS_SKILLS, BUILTIN_SKILL_ENTRIES, CLAUDE_HOMES, CLAUDE_IMPORT, CODEX_HOMES,
  FORBIDDEN_SKILL_DIRS, LEGACY_CLAUDE_IMPORT, LEGACY_CODEX_RULES, LEGACY_PI_GUARD, Log, MARK_BEGIN, MARK_END,
  OPENCODE_HOMES, PI_GUARD, PI_HOMES, PROFILES_FILE, PROGRAMS, REPO, SKILLS, ZSHENV, canon, claudeAskRules,
  codexRulesText, ensureSymlink, isFile, isSymlink, lexists, linkTarget, listDir, loadJson, loadState,
  mcpServers, opencodeRules, quarantine, readText, reportHarnesses, saveJson, saveState, short,
  skills, stripMarkedBlock, stripTomlTables, tomlStr, validateSkill,
} from "./agentrc.mjs";

const DRY = process.argv.includes("--dry-run");

function syncSkills(log) {
  log.section("Skills");
  const found = skills();
  for (const [name, path] of Object.entries(found)) validateSkill(name, path, log);
  if (log.errors.length) {
    console.log("\nFix the skill errors above; nothing was linked.");
    return false;
  }

  for (const target of [AGENTS_SKILLS, ...CLAUDE_HOMES.map((h) => join(h, "skills"))]) {
    mkdirSync(target, { recursive: true });
    for (const name of listDir(target)) {
      const entry = join(target, name);
      if (BUILTIN_SKILL_ENTRIES.has(name)) continue;
      const ours = isSymlink(entry) && dirname(linkTarget(entry)) === SKILLS;
      if (ours && name in found) continue;
      if (DRY) log.change(`would remove/quarantine ${short(entry)}`);
      else if (isSymlink(entry)) {
        unlinkSync(entry);
        log.change(`removed stale link ${short(entry)}`);
      } else quarantine(entry, log, "not managed by agentrc");
    }
    for (const [name, path] of Object.entries(found)) {
      const link = join(target, name);
      if (!(isSymlink(link) && linkTarget(link) === path)) {
        if (DRY) log.change(`would link ${short(link)}`);
        else ensureSymlink(link, path, log);
      }
    }
    log.ok(`${short(target)}: ${Object.keys(found).length} skills`);
  }

  for (const d of FORBIDDEN_SKILL_DIRS) {
    if (lexists(d) && !DRY) {
      for (const name of listDir(d)) quarantine(join(d, name), log, "harness-specific skills folder; use ~/agentrc/skills");
      rmdirSync(d);
      log.change(`removed ${short(d)}`);
    }
  }
  return true;
}

function syncInstructions(log) {
  log.section("Global instructions");
  for (const home of CLAUDE_HOMES) {
    const f = join(home, "CLAUDE.md");
    if (isFile(f) && !isSymlink(f) && readText(f) === CLAUDE_IMPORT) {
      log.ok(`${short(f)} imports AGENTS.md`);
      continue;
    }
    if (DRY) { log.change(`would write ${short(f)}`); continue; }
    if (isFile(f) && readText(f) === LEGACY_CLAUDE_IMPORT) {
      // written by this tool under its old name; nothing to keep
    } else if (lexists(f)) {
      const backup = join(home, "CLAUDE.md.pre-agentrc");
      renameSync(f, backup);
      log.change(`kept old ${short(f)} as ${short(backup)}`);
    }
    writeFileSync(f, CLAUDE_IMPORT);
    log.change(`wrote ${short(f)} (@~/agentrc/AGENTS.md)`);
  }

  for (const link of [...CODEX_HOMES, ...OPENCODE_HOMES, ...PI_HOMES].map((h) => join(h, "AGENTS.md"))) {
    if (isSymlink(link) && linkTarget(link) === AGENTS_MD) log.ok(`${short(link)} -> AGENTS.md`);
    else if (DRY) log.change(`would link ${short(link)}`);
    else ensureSymlink(link, AGENTS_MD, log);
  }
}

function syncPolicy(log, state) {
  log.section("Approval policy (policy/ask.txt)");
  const ask = claudeAskRules();
  for (const home of CLAUDE_HOMES) {
    const f = join(home, "settings.json");
    const data = loadJson(f);
    data.permissions ??= {};
    const perms = data.permissions;
    const previous = new Set(state.claude_ask ?? []);
    const current = (perms.ask ?? []).filter((r) => !previous.has(r));
    const merged = [...current, ...ask.filter((r) => !current.includes(r))];
    if (canon(merged) !== canon(perms.ask)) {
      perms.ask = merged;
      saveJson(f, data);
      log.change(`${short(f)}: permissions.ask now has ${ask.length} agentrc rules`);
    } else log.ok(`${short(f)}: ${ask.length} ask rules`);
  }
  state.claude_ask = ask;

  const text = codexRulesText();
  for (const home of CODEX_HOMES) {
    const legacy = join(home, "rules", LEGACY_CODEX_RULES);
    if (existsSync(legacy)) {
      unlinkSync(legacy);
      log.change(`removed ${short(legacy)} (old name)`);
    }
    const f = join(home, "rules", "agentrc.rules");
    if (existsSync(f) && readText(f) === text) { log.ok(short(f)); continue; }
    mkdirSync(dirname(f), { recursive: true });
    writeFileSync(f, text);
    log.change(`wrote ${short(f)}`);
  }

  for (const home of OPENCODE_HOMES) {
    const f = join(home, "opencode.json");
    const data = loadJson(f);
    const before = canon(data);
    delete data.permissions;  // V2 array; the installed OpenCode (V1) refuses to start with it
    data.permission ??= {};
    const perm = data.permission;
    if (typeof perm.bash === "string") perm.bash = { "*": perm.bash };
    perm.bash ??= {};
    for (const pattern of state.opencode_bash ?? []) delete perm.bash[pattern];
    const added = opencodeRules();
    Object.assign(perm.bash, added);
    const count = Object.keys(added).length;
    if (canon(data) !== before) {
      saveJson(f, data);
      log.change(`${short(f)}: permission.bash has ${count} agentrc patterns`);
    } else log.ok(`${short(f)}: ${count} permission.bash patterns`);
    state.opencode_bash = Object.keys(added);
    delete state.opencode_rules;
  }

  for (const home of PI_HOMES) {
    const legacy = join(home, "extensions", LEGACY_PI_GUARD);
    if (isSymlink(legacy)) {
      unlinkSync(legacy);
      log.change(`removed ${short(legacy)} (old name)`);
    }
    const guard = join(home, "extensions", "agentrc-guard.ts");
    ensureSymlink(guard, PI_GUARD, log);
    log.ok(short(guard));
  }
}

function syncMcp(log, state) {
  log.section("MCP servers (mcp.json)");
  const { servers, skipped } = mcpServers(log);
  const names = Object.keys(servers).join(", ");
  const previous = new Set(state.mcp ?? []);
  const removed = [...previous].filter((n) => !(n in servers) && !skipped.includes(n)).sort();
  const claude = (home, ...args) => spawnSync(PROGRAMS.claude, args,
    { env: { ...process.env, CLAUDE_CONFIG_DIR: home }, encoding: "utf8" });

  // Claude Code: through its CLI, so running sessions don't race a direct file write.
  for (const home of CLAUDE_HOMES) {
    const current = loadJson(join(home, ".claude.json")).mcpServers ?? {};
    for (const name of removed) {
      if (name in current) {
        claude(home, "mcp", "remove", "-s", "user", name);
        log.change(`claude ${short(home)}: removed ${name}`);
      }
    }
    for (const [name, spec] of Object.entries(servers)) {
      const want = { type: "http", url: spec.url, ...(Object.keys(spec.headers).length ? { headers: spec.headers } : {}) };
      const have = current[name];
      if (have && canon(Object.fromEntries(Object.keys(want).map((k) => [k, have[k] ?? null]))) === canon(want)) continue;
      if (have) claude(home, "mcp", "remove", "-s", "user", name);
      const args = ["mcp", "add", "-s", "user", "--transport", "http", name, spec.url];
      for (const [k, v] of Object.entries(spec.headers)) args.push("-H", `${k}: ${v}`);
      const r = claude(home, ...args);
      if (r.status === 0) log.change(`claude ${short(home)}: ${name}`);
      else log.error(`claude ${short(home)}: adding ${name} failed: ${(r.stderr ?? "").trim().slice(0, 200)}`);
    }
    log.ok(`claude ${short(home)}: ${names}`);
  }

  // Codex: one marked block in config.toml.
  for (const home of CODEX_HOMES) {
    const f = join(home, "config.toml");
    const text = existsSync(f) ? readText(f) : "";
    const body = stripTomlTables(stripMarkedBlock(text), [...Object.keys(servers), ...removed]).replace(/\n+$/, "");
    const block = [MARK_BEGIN, "# MCP servers from ~/agentrc/mcp.json. Edit there, then run bin/sync."];
    for (const [name, spec] of Object.entries(servers)) {
      block.push("", `[mcp_servers.${name}]`, `url = ${tomlStr(spec.url)}`);
      const pairs = Object.entries(spec.headers).map(([k, v]) => `${tomlStr(k)} = ${tomlStr(v)}`).join(", ");
      if (pairs) block.push(`http_headers = { ${pairs} }`);
    }
    block.push(MARK_END);
    const next = `${body}\n\n${block.join("\n")}\n`;
    if (next !== text) {
      writeFileSync(f, next);
      log.change(`${short(f)}: mcp_servers ${names}`);
    } else log.ok(`${short(f)}: ${names}`);
  }

  // OpenCode
  for (const home of OPENCODE_HOMES) {
    const f = join(home, "opencode.json");
    const data = loadJson(f);
    data.mcp ??= {};
    const before = canon(data.mcp);
    for (const name of removed) delete data.mcp[name];
    for (const [name, spec] of Object.entries(servers)) {
      data.mcp[name] = { type: "remote", url: spec.url, enabled: true,
        ...(Object.keys(spec.headers).length ? { headers: spec.headers } : {}) };
    }
    if (canon(data.mcp) !== before) {
      saveJson(f, data);
      log.change(`${short(f)}: mcp ${names}`);
    } else log.ok(`${short(f)}: ${names}`);
  }

  // Pi
  for (const home of PI_HOMES) {
    const f = join(home, "mcp.json");
    const data = loadJson(f);
    data.mcpServers ??= {};
    const before = canon(data.mcpServers);
    for (const name of removed) delete data.mcpServers[name];
    for (const [name, spec] of Object.entries(servers)) {
      data.mcpServers[name] = { url: spec.url, ...(Object.keys(spec.headers).length ? { headers: spec.headers } : {}) };
    }
    if (canon(data.mcpServers) !== before) {
      saveJson(f, data);
      chmodSync(f, 0o600);
      log.change(`${short(f)}: mcpServers ${names}`);
    } else log.ok(`${short(f)}: ${names}`);
  }

  state.mcp = [...new Set([...Object.keys(servers), ...[...previous].filter((n) => skipped.includes(n))])].sort();
}

function syncEnv(log) {
  log.section("Environment");
  const block = `${MARK_BEGIN}\n# Managed by ~/agentrc/bin/sync.\n` +
    "# OpenCode also scans ~/.claude/skills; the same skills already come from ~/.agents/skills.\n" +
    `export OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1\n${MARK_END}\n`;
  const text = existsSync(ZSHENV) ? readText(ZSHENV) : "";
  if (!OPENCODE_HOMES.length) {
    if (text.includes(MARK_BEGIN)) {
      const rest = stripMarkedBlock(text).replace(/\n+$/, "");
      writeFileSync(ZSHENV, rest ? rest + "\n" : "");
      log.change(`${short(ZSHENV)}: removed OPENCODE_DISABLE_CLAUDE_CODE_SKILLS (OpenCode not installed)`);
    }
    return;
  }
  if (text.includes(block)) {
    log.ok(`${short(ZSHENV)}: OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1`);
    return;
  }
  const rest = stripMarkedBlock(text).replace(/\n+$/, "");
  writeFileSync(ZSHENV, (rest ? rest + "\n\n" : "") + block);
  log.change(`${short(ZSHENV)}: OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1 (open a new shell)`);
}

function main() {
  const log = new Log();
  console.log(`agentrc sync${DRY ? " (dry run)" : ""}: ${short(REPO)}`);
  reportHarnesses(log);
  if (log.errors.length) {
    console.log(`\nFix ${short(PROFILES_FILE)} first; nothing was changed.`);
    return 1;
  }
  if (!syncSkills(log)) return 1;
  syncInstructions(log);
  if (!DRY) {
    const state = loadState();
    syncPolicy(log, state);
    syncMcp(log, state);
    syncEnv(log);
    saveState(state);
  }
  console.log(`\n${log.errors.length} error(s), ${log.warnings.length} warning(s). Run bin/doctor to verify.`);
  return log.errors.length ? 1 : 0;
}

process.exitCode = main();
