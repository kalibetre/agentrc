#!/usr/bin/env node
// Compare vendored skills with their upstream repos.
//
//   bin/update                 fetch every upstream in skills.lock, show what changed
//   bin/update --diff <name>   print the full diff for one skill
//   bin/update --apply <name>  replace skills/<name> with upstream and record the new commit
//
// Upstreams are cloned into a temporary directory and never executed.
// After --apply, re-apply the local changes listed in skills.lock, then run
// bin/sync, bin/doctor and commit.
import { spawnSync } from "node:child_process";
import { cpSync, existsSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { basename, join } from "node:path";
import { LOCK, SKILLS, isDir, lockEntries, readText } from "./agentrc.mjs";

const SKIP_SOURCES = new Set(["local", "merged"]);
const USAGE = readText(new URL(import.meta.url).pathname).split("\n").slice(1, 11).map((l) => l.replace(/^\/\/ ?/, "")).join("\n");

function fail(msg) {
  console.error(msg);
  process.exit(1);
}

function git(...args) {
  const r = spawnSync("git", args, { encoding: "utf8" });
  if (r.status !== 0) fail(`git ${args.join(" ")} failed: ${(r.stderr ?? "").trim()}`);
  return r.stdout.trim();
}

function clone(source, into) {
  const dest = join(into, source.replaceAll("/", "__"));
  if (!existsSync(dest)) git("clone", "-q", "--depth", "1", `https://github.com/${source}.git`, dest);
  return { dest, head: git("-C", dest, "rev-parse", "HEAD") };
}

const diff = (a, b) => spawnSync("diff", ["-ru", "-x", ".git", a, b], { encoding: "utf8", maxBuffer: 1 << 28 }).stdout;
const count = (s) => s.split("\n").length - 1;

function main() {
  const args = process.argv.slice(2);
  let mode = "summary", target = null;
  if (args.length === 2 && ["--diff", "--apply"].includes(args[0])) [mode, target] = [args[0].slice(2), args[1]];
  else if (args.length) { console.log(USAGE); return 2; }

  const lock = lockEntries();
  if (target && !(target in lock)) fail(`${target} is not in skills.lock`);
  const tmp = mkdtempSync(join(tmpdir(), "agentrc-update-"));
  try {
    for (const [name, e] of Object.entries(lock)) {
      if (target && name !== target) continue;
      if (SKIP_SOURCES.has(e.source) || e.path === "-") {
        if (target) fail(`${name} has source '${e.source}'; update it by hand`);
        continue;
      }
      const { dest, head } = clone(e.source, tmp);
      const upstream = join(dest, e.path);
      if (!isDir(upstream)) { console.log(`  ??    ${name}: ${e.path} no longer exists in ${e.source}`); continue; }
      const d = diff(join(SKILLS, name), upstream);
      const changed = e.changes !== "-" ? `local changes: ${e.changes}` : "";
      if (mode === "summary") {
        const state = !d ? "up to date" : `differs (${count(d)} diff lines)`;
        const moved = head.startsWith(e.commit) ? "" : ` upstream ${e.commit.slice(0, 7)} -> ${head.slice(0, 7)}`;
        console.log(`  ${name.padEnd(31)} ${state}${moved} ${changed}`);
      } else if (mode === "diff") {
        console.log(d || `${name}: identical to upstream`);
      } else {
        rmSync(join(SKILLS, name), { recursive: true });
        cpSync(upstream, join(SKILLS, name), { recursive: true, filter: (src) => ![".git", ".DS_Store"].includes(basename(src)) });
        const esc = name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        writeFileSync(LOCK, readText(LOCK).replace(new RegExp(`^(${esc}\\s+\\S+\\s+\\S+\\s+)\\S+`, "m"), (_, pre) => pre + head));
        console.log(`${name}: replaced with ${e.source}@${head.slice(0, 7)}`);
        if (changed) console.log(`Re-apply the ${changed}`);
        console.log("Then: bin/sync && bin/doctor && git commit");
      }
    }
  } finally {
    rmSync(tmp, { recursive: true, force: true });
  }
  return 0;
}

process.exitCode = main();
